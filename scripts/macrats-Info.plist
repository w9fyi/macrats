<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>

    <key>CFBundleIdentifier</key>
    <string>com.ai5os.macrats</string>

    <key>CFBundleName</key>
    <string>MacRats</string>

    <key>CFBundleDisplayName</key>
    <string>MacRats</string>

    <key>CFBundleExecutable</key>
    <string>macrats</string>

    <key>CFBundleVersion</key>
    <string>__BUILD__</string>

    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleSignature</key>
    <string>????</string>

    <key>CFBundleSupportedPlatforms</key>
    <array>
        <string>MacOSX</string>
    </array>

    <!-- Minimum macOS version — matches Package.swift (.macOS(.v14)) -->
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <!-- Regular GUI app with a dock icon (not a menu bar / agent app). -->
    <key>LSUIElement</key>
    <false/>

    <key>NSHighResolutionCapable</key>
    <true/>

    <key>NSSupportsAutomaticTermination</key>
    <true/>

    <key>NSSupportsSuddenTermination</key>
    <true/>

    <!-- Principal class for a SwiftUI @main App: the default AppKit app. -->
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <!-- Legal / about-panel metadata. -->
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Justin Mann (AI5OS). GPL-3.</string>

    <!-- Enable automatic VoiceOver + switch control + full keyboard access
         hooks. Optional but good practice for an accessibility-first app. -->
    <key>NSAccessibilityEnabled</key>
    <true/>

    <!-- Bluetooth usage description. Required by TCC on macOS 11+ before
         an application can open an IOBluetoothRFCOMMChannel. Without this,
         the first bring-up attempt returns kIOReturnNotPermitted and macOS
         shows no prompt — the denial is silent. -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>MacRats uses Bluetooth to connect to your Kenwood TH-D74 or TH-D75 radio over Serial Port Profile (SPP) for sending and receiving D-Rats messages.</string>
</dict>
</plist>
